---
layout: null
permalink: /search.json
---
{% assign public_notes = site.notes | where_exp: "note", "note.published != false" %}
{% assign public_moments = site.moments | where_exp: "moment", "moment.published != false" %}
{% assign empty_tags = "" | split: "," %}
[
  {% for note in public_notes %}{
    "type": "note",
    "title": {{ note.title | jsonify }},
    "url": {{ note.url | relative_url | jsonify }},
    "excerpt": {{ note.excerpt | strip_html | truncate: 160 | jsonify }},
    "tags": {{ note.tags | default: empty_tags | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
  {% if public_notes.size > 0 and public_moments.size > 0 %},{% endif %}
  {% for moment in public_moments %}{
    "type": "moment",
    "title": {{ moment.excerpt | strip_html | truncate: 36 | jsonify }},
    "url": {{ moment.url | relative_url | jsonify }},
    "excerpt": {{ moment.excerpt | strip_html | truncate: 160 | jsonify }},
    "tags": []
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
